# =============================================================================
#  SOC-RUN — Règles Suricata (approche SOC réelle)
# =============================================================================
#
# 
# Détecter les COMPORTEMENTS sur le réseau  ($HOME_NET / serveurs),
# quelle que soit la source (any).
#
# $HOME_NET  = réseaux du lab (voir suricata.yaml)
# $HTTP_PORTS, ports standards = surface d'attaque typique
#
# SIDs custom : 1100xxx
# =============================================================================

# --- [1100] ICMP (anomalies / DoS) ---
# Ping isolé = trop bruyant en prod → on garde surtout le flood
alert icmp any any -> $HOME_NET any (msg:"SOC-RUN - ICMP Flood detecte"; itype:8; threshold:type both, track by_src, count 50, seconds 5; classtype:attempted-dos; sid:1100002; rev:2;)

# --- [1101] Scans réseau (comportement, pas d'IP connue) ---
alert tcp any any -> $HOME_NET any (msg:"SOC-RUN - SYN Scan / port sweep probable"; flags:S; flow:stateless; threshold:type both, track by_src, count 10, seconds 5; classtype:network-scan; sid:1101001; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"SOC-RUN - TCP Connect Scan probable"; flags:S; flow:stateless; threshold:type both, track by_src, count 15, seconds 5; classtype:network-scan; sid:1101002; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"SOC-RUN - FIN Scan detecte"; flags:F; flow:stateless; classtype:network-scan; sid:1101003; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"SOC-RUN - NULL Scan detecte"; flags:0; flow:stateless; classtype:network-scan; sid:1101004; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"SOC-RUN - Xmas Scan detecte"; flags:FPU; flow:stateless; classtype:network-scan; sid:1101005; rev:2;)
alert http any any -> $HOME_NET any (msg:"SOC-RUN - User-Agent Nmap (version scan HTTP)"; http.user_agent; content:"Nmap"; nocase; classtype:network-scan; sid:1101006; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"SOC-RUN - Scan agressif / OS fingerprint probable"; flags:S; flow:stateless; threshold:type both, track by_src, count 30, seconds 10; classtype:network-scan; sid:1101007; rev:2;)

# --- [1102] SSH — brute force & sweep (toute source → serveurs) ---
alert tcp any any -> $HOME_NET 22 (msg:"SOC-RUN - SSH brute force probable"; flow:to_server,established; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-user; sid:1102001; rev:2;)
alert tcp any any -> $HOME_NET 22 (msg:"SOC-RUN - SSH scan massif (SYN)"; flow:to_server; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:network-scan; sid:1102004; rev:2;)

# --- [1103] HTTP — outils d'enum & attaques applicatives ---
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Outil Gobuster detecte"; http.user_agent; content:"gobuster"; nocase; classtype:web-application-attack; sid:1103001; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Outil DirBuster detecte"; http.user_agent; content:"DirBuster"; nocase; classtype:web-application-attack; sid:1103002; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Outil dirb detecte"; http.user_agent; content:"dirb"; nocase; classtype:web-application-attack; sid:1103003; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Scanner Nikto detecte"; http.user_agent; content:"Nikto"; nocase; classtype:web-application-attack; sid:1103004; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - sqlmap detecte"; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:1103014; rev:1;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - curl/wget automatise suspect (volume)"; http.user_agent; content:"curl/"; nocase; threshold:type both, track by_src, count 50, seconds 10; classtype:web-application-activity; sid:1103015; rev:1;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - HTTP flood / enumeration volume"; threshold:type both, track by_src, count 100, seconds 10; classtype:attempted-dos; sid:1103005; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Acces chemin /admin"; http.uri; content:"/admin"; nocase; classtype:web-application-activity; sid:1103006; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Acces chemin /backup"; http.uri; content:"/backup"; nocase; classtype:web-application-activity; sid:1103007; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Acces /.git (fuite repo)"; http.uri; content:"/.git"; classtype:attempted-recon; sid:1103008; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Acces chemin /secret"; http.uri; content:"/secret"; nocase; classtype:web-application-activity; sid:1103009; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Acces PHP sensible (config/shell/admin)"; http.uri; content:".php"; nocase; pcre:"/\/(config|setup|install|admin|shell|cmd|exec).*\.php/i"; classtype:web-application-attack; sid:1103010; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - SQLi probable (UNION)"; http.uri; content:"UNION"; nocase; classtype:web-application-attack; sid:1103011; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - SQLi probable (OR 1=1)"; http.uri; content:"OR 1=1"; nocase; classtype:web-application-attack; sid:1103012; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - XSS probable (<script>)"; http.uri; content:"<script>"; nocase; classtype:web-application-attack; sid:1103013; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Path traversal probable (../)"; http.uri; content:"../"; classtype:web-application-attack; sid:1103016; rev:1;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - Command injection probable dans URI"; http.uri; content:"&&"; classtype:web-application-attack; sid:1103017; rev:2;)

# --- [1104] DNS — flood / tunneling (signatures comportementales) ---
alert dns any any -> $HOME_NET 53 (msg:"SOC-RUN - DNS flood probable"; threshold:type both, track by_src, count 100, seconds 10; classtype:attempted-dos; sid:1104001; rev:2;)
alert dns any any -> $HOME_NET 53 (msg:"SOC-RUN - Volume DNS eleve (tunneling potentiel)"; threshold:type both, track by_src, count 200, seconds 30; classtype:bad-unknown; sid:1104002; rev:2;)
alert dns any any -> $HOME_NET 53 (msg:"SOC-RUN - Requete DNS tres longue (tunneling/exfil)"; dns.query; pcre:"/^.{60,}/"; classtype:bad-unknown; sid:1104004; rev:2;)

# --- [1105] FTP — comportements suspects ---
alert tcp any any -> $HOME_NET 21 (msg:"SOC-RUN - FTP login anonyme"; flow:to_server,established; content:"USER anonymous"; nocase; classtype:suspicious-login; sid:1105001; rev:2;)
alert tcp any any -> $HOME_NET 21 (msg:"SOC-RUN - FTP brute force probable"; flow:to_server,established; detection_filter:track by_src, count 10, seconds 30; classtype:attempted-user; sid:1105002; rev:2;)
alert tcp any any -> $HOME_NET 21 (msg:"SOC-RUN - FTP RETR (download)"; flow:to_server,established; content:"RETR"; nocase; classtype:protocol-command-decode; sid:1105003; rev:2;)
alert tcp any any -> $HOME_NET 21 (msg:"SOC-RUN - FTP STOR (upload)"; flow:to_server,established; content:"STOR"; nocase; classtype:bad-unknown; sid:1105004; rev:2;)

# --- [1106] Mouvement / reconnaissance large (sans nommer attaquant) ---
alert tcp any any -> $HOME_NET any (msg:"SOC-RUN - Connexions TCP nombreuses (recon/lateral)"; flags:S; flow:stateless; threshold:type both, track by_src, count 40, seconds 5; classtype:network-scan; sid:1106001; rev:2;)

# --- [1107] Apps vulnérables connues (signature URI, pas d'IP cible) ---
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - DVWA login brute force"; http.method; content:"POST"; http.uri; content:"/dvwa/login.php"; detection_filter:track by_src, count 10, seconds 30; classtype:web-application-attack; sid:1107001; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - DVWA command injection"; http.uri; content:"/dvwa/vulnerabilities/exec/"; classtype:web-application-attack; sid:1107002; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - DVWA file inclusion"; http.uri; content:"/dvwa/vulnerabilities/fi/"; classtype:web-application-attack; sid:1107003; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - DVWA SQL injection"; http.uri; content:"/dvwa/vulnerabilities/sqli/"; classtype:web-application-attack; sid:1107004; rev:2;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC-RUN - DVWA XSS"; http.uri; content:"/dvwa/vulnerabilities/xss_"; classtype:web-application-attack; sid:1107005; rev:2;)
