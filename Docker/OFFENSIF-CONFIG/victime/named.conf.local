// Zone locale pour les tests DNS
zone "victime.local" {
    type master;
    file "/etc/bind/db.victime.local";
};

// Permettre les requêtes récursives (utile pour simuler du tunneling DNS)
options {
    recursion yes;
    allow-recursion { any; };
    allow-query { any; };
    listen-on { any; };
    listen-on-v6 { none; };

    // Forwarders vers DNS publics (pour générer du trafic DNS externe)
    forwarders {
        8.8.8.8;
        1.1.1.1;
    };
    forward only;
};
