# =============================================================================
# Regles custom SOC ÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂ¢ÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂÃÂ complement de suricata.rules (ET)
# Suricata 8.x | SIDs 1100xxx | une regle = une ligne
# Contexte dans Kibana : url.original, user_agent.original, payload_printable
# =============================================================================

# --- ICMP ---
alert icmp any any -> $HOME_NET any (msg:"SOC | Flood ICMP echo"; itype:8; threshold:type both, track by_src, count 80, seconds 5; classtype:attempted-dos; sid:1100001; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Major, attack_target Server, mitre_tactic_id TA0040, mitre_tactic_name Impact;)

# --- Scans TCP ---
alert tcp any any -> $HOME_NET any (msg:"SOC | Balayage de ports TCP SYN"; flags:S,12; flow:stateless; threshold:type both, track by_src, count 40, seconds 10; classtype:network-scan; sid:1100101; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert tcp any any -> $HOME_NET any (msg:"SOC | Scan TCP FIN"; flags:F,12; flow:stateless; threshold:type both, track by_src, count 8, seconds 10; classtype:network-scan; sid:1100102; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert tcp any any -> $HOME_NET any (msg:"SOC | Scan TCP NULL"; flags:0; flow:stateless; threshold:type both, track by_src, count 8, seconds 10; classtype:network-scan; sid:1100103; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert tcp any any -> $HOME_NET any (msg:"SOC | Scan TCP Xmas"; flags:FPU,12; flow:stateless; threshold:type both, track by_src, count 8, seconds 10; classtype:network-scan; sid:1100104; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | User-Agent Nmap detecte"; flow:to_server; http.user_agent; content:"Nmap"; nocase; fast_pattern; classtype:network-scan; sid:1100105; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)

# --- SSH (Hydra reutilise peu de SYN : detecter la couche applicative SSH) ---
alert ssh any any -> $HOME_NET any (msg:"SOC | Brute force SSH probable"; flow:to_server; detection_filter:track by_src, count 4, seconds 60; classtype:attempted-user; sid:1100201; rev:8; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Server, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access;)
alert tcp any any -> $HOME_NET 22 (msg:"SOC | Rafale de connexions TCP vers SSH"; flow:to_server; flags:S,12; detection_filter:track by_src, count 8, seconds 30; classtype:attempted-user; sid:1100202; rev:6; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Server, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access;)
alert ssh any any -> $HOME_NET any (msg:"SOC | Client SSH libssh (outil automatise probable)"; flow:to_server; ssh.software; content:"libssh"; nocase; classtype:misc-activity; sid:1100203; rev:1; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Server, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access;)

# --- Scanners web (User-Agent) ---
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Scanner web Gobuster detecte"; flow:to_server; http.user_agent; content:"gobuster"; nocase; fast_pattern; classtype:web-application-attack; sid:1100301; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Scanner web DirBuster detecte"; flow:to_server; http.user_agent; content:"DirBuster"; nocase; fast_pattern; classtype:web-application-attack; sid:1100302; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Scanner web Nikto detecte"; flow:to_server; http.user_agent; content:"Nikto"; nocase; fast_pattern; classtype:web-application-attack; sid:1100303; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Outil sqlmap detecte"; flow:to_server; http.user_agent; content:"sqlmap"; nocase; fast_pattern; classtype:web-application-attack; sid:1100304; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Critical, attack_target Web_Server, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Scanner Nuclei detecte"; flow:to_server; http.user_agent; content:"Nuclei"; nocase; fast_pattern; classtype:web-application-attack; sid:1100305; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Flood de requetes HTTP"; flow:to_server; threshold:type both, track by_src, count 200, seconds 10; classtype:attempted-dos; sid:1100306; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0040, mitre_tactic_name Impact;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Client curl/wget a volume eleve"; flow:to_server; http.user_agent; pcre:"/^(?:curl|Wget|wget)\/[0-9]/i"; detection_filter:track by_src, count 30, seconds 10; classtype:web-application-activity; sid:1100324; rev:4; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Web_Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)

# --- Fichiers / chemins sensibles ---
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Acces au depot Git (/.git)"; flow:to_server; http.uri; content:"/.git"; fast_pattern; classtype:attempted-recon; sid:1100310; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Acces au fichier d environnement (/.env)"; flow:to_server; http.uri; content:"/.env"; fast_pattern; classtype:attempted-recon; sid:1100311; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Acces a une archive ou backup via HTTP"; flow:to_server; http.uri; pcre:"/\.(?:bak|old|zip|tar|tgz|gz|sql|7z|rar)(?:$|[?#])/i"; classtype:attempted-recon; sid:1100312; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Web_Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery;)

# --- Attaques applicatives (payload dans url.original) ---
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Injection SQL UNION SELECT"; flow:to_server; http.uri; content:"union"; nocase; fast_pattern; pcre:"/\bunion[\s+\/]*(?:all[\s+\/]+)?select\b/i"; classtype:web-application-attack; sid:1100320; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Traversal de chemin"; flow:to_server; http.uri; pcre:"/(?:\.\.\/|\.\.\\|\.\.%2f|\.\.%5c|%2e%2e(?:\/|\\|%2f|%5c))/i"; classtype:web-application-attack; sid:1100321; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Web_Server, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | XSS probable dans l URI"; flow:to_server; http.uri; pcre:"/(?:<script\b|javascript\s*:|on(?:error|load|click|mouseover)\s*=)/i"; classtype:web-application-attack; sid:1100322; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Web_Server, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Injection de commande systeme dans l URI"; flow:to_server; http.uri; pcre:"/(?:&&|\|\|)\s*(?:id|whoami|uname|cat|curl|wget|nc|ncat|bash|sh|powershell|cmd)\b/i"; classtype:web-application-attack; sid:1100323; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Critical, attack_target Web_Server, mitre_tactic_id TA0002, mitre_tactic_name Execution;)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SOC | Injection de commande via separateur URL encode"; flow:to_server; http.uri; pcre:"/%3b\s*(?:id|whoami|uname|cat|curl|wget|nc|bash|sh)\b/i"; classtype:web-application-attack; sid:1100325; rev:1; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Critical, attack_target Web_Server, mitre_tactic_id TA0002, mitre_tactic_name Execution;)

# --- DNS ---
alert dns any any -> $DNS_SERVERS 53 (msg:"SOC | Flood de requetes DNS"; flow:to_server; threshold:type both, track by_src, count 150, seconds 10; classtype:attempted-dos; sid:1100401; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target DNS_Server, mitre_tactic_id TA0040, mitre_tactic_name Impact;)
alert dns any any -> $DNS_SERVERS 53 (msg:"SOC | Requete DNS anormalement longue"; flow:to_server; dns.query; pcre:"/^.{80,}$/"; classtype:bad-unknown; sid:1100402; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target DNS_Server, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control;)

# --- FTP (commandes en clair dans payload_printable) ---
alert tcp any any -> $HOME_NET 21 (msg:"SOC | Connexion FTP anonyme"; flow:to_server,established; content:"USER anonymous"; nocase; fast_pattern; classtype:suspicious-login; sid:1100501; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Medium, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access;)
alert tcp any any -> $HOME_NET 21 (msg:"SOC | Brute force FTP probable"; flow:to_server,established; content:"USER "; nocase; fast_pattern; detection_filter:track by_src, count 15, seconds 30; classtype:attempted-user; sid:1100502; rev:5; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Server, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access;)
alert tcp any any -> $HOME_NET 21 (msg:"SOC | Telechargement FTP (RETR)"; flow:to_server,established; content:"RETR "; nocase; fast_pattern; classtype:protocol-command-decode; sid:1100503; rev:4; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity Low, attack_target Server, mitre_tactic_id TA0009, mitre_tactic_name Collection;)
alert tcp any any -> $HOME_NET 21 (msg:"SOC | Upload FTP (STOR)"; flow:to_server,established; content:"STOR "; nocase; fast_pattern; classtype:bad-unknown; sid:1100504; rev:4; metadata:created_at 2026_10_02, updated_at 2026_10_02, signature_severity High, attack_target Server, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control;)
